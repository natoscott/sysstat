. tests/variables
if [ "$HAVE_PCP" = "y" ]; then
	# Verify sadc gracefully skips local metrics when sysstat.pcpconf absent
	rm -f tests/pcpar-sadc2.*
	rm -f tests/root
	ln -s ${T_SRCDIR}/tests/root1 tests/root
	# PCP_CONF=/dev/null means no local metrics — sadc should still succeed
	TZ=GMT PCP_CONF=/dev/null ./sadc --unix_time=1555593619 \
		-S XALL,-A_PWR_FAN,-A_PWR_IN,-A_PWR_TEMP,-A_PWR_FREQ \
		-O pcp=tests/pcpar-sadc2 tests/data.tmp 1 1 >/dev/null 2>&1 || exit 1
	# Archive must be readable and contain the standard sadc.* metrics
	pminfo -a tests/pcpar-sadc2 sadc.version sadc.activities > /dev/null 2>&1 || exit 1
	rm -f tests/root
	ln -s ${T_SRCDIR}/tests/root1 tests/root
else
	echo Skipped; touch tests/SKIPPED
fi
