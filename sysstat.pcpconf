# sysstat PCP local metric collection configuration.
#
# This file configures collection of metrics from any PCP DSO PMDA alongside
# the standard system-wide sysstat metrics.  The default set covers
# per-process metrics (pidstat), CIFS filesystem statistics (cifsiostat),
# and tape drive statistics (tapestat).
#
# When sadc is configured to write PCP archives (PCP_SA_OPTIONS="-O sa+pcp"
# or "-O pcp" in /etc/sysconfig/sysstat), metrics listed here are collected
# from a local PMDA context at the configured interval and stored in the same
# PCP archive.  Tools such as "pidstat -a", "iostat -a", and "mpstat -a" can
# then replay these metrics historically from the archive.
#
# Changes take effect on the next sadc restart.
# See sysstat.pcpconf(5) and sadc(8) for details.

[settings]
# Minimum gap in seconds between consecutive local PMDA fetch cycles within
# a single long-running sadc process.  Prevents expensive PMDA calls (e.g.
# proc.* across thousands of processes) from firing on every short main
# collection cycle.  Has no effect when sadc is invoked as a one-shot
# process (the default systemd/cron configuration), since last_local_ust
# resets to zero on each fresh invocation.  Tune upward for high-frequency
# sadc deployments (e.g. sadc 1 3600).  Default: 15 seconds.
interval = 15

# Maximum PCP archive data volume size before automatic rotation (bytes).
# Set to 0 to disable in-session rotation.
# volume_size = 104857600

[pmdas]
# Additional PMDAs to load via pmSpecLocalPMDA(3).
# The proc PMDA is always loaded automatically.
# Uncomment 'linux' to record extended kernel metrics via the PMDA
# (in addition to those already written by sadc's built-in collectors).
# linux

[metrics]
# Metric names to record, one per line.  Non-leaf names (e.g. proc.psinfo)
# are expanded to all leaves beneath them.  Metrics already collected by
# sadc's built-in path are silently skipped.
#
# The default set below covers the metrics needed by pcp-pidstat(1).
# See also: /etc/pcp/pmlogconf/tools/pidstat
#           /etc/pcp/pmlogconf/tools/atop-proc
proc.nprocs
proc.psinfo.pid
proc.psinfo.cmd
proc.psinfo.utime
proc.psinfo.stime
proc.psinfo.guest_time
proc.psinfo.minflt
proc.psinfo.maj_flt
proc.psinfo.vsize
proc.psinfo.rss
proc.psinfo.processor
proc.psinfo.rt_priority
proc.psinfo.policy
proc.psinfo.threads
proc.psinfo.vctxsw
proc.psinfo.nvctxsw
proc.psinfo.wchan_s
proc.psinfo.psargs
proc.memory.vmstack
proc.io.rchar
proc.io.wchar
proc.io.read_bytes
proc.io.write_bytes
proc.id.uid
proc.id.uid_nm
proc.fd.count
proc.schedstat.run_delay
