#!/bin/sh
# @SA_LIB_DIR@/sa2
# (C) 1999-2025 Sebastien Godard (sysstat <at> orange.fr)
#
#@(#) @PACKAGE_NAME@-@PACKAGE_VERSION@
#@(#) sa2: Write a daily report
#
S_TIME_FORMAT=ISO ; export S_TIME_FORMAT
prefix=@prefix@
exec_prefix=@exec_prefix@
SA_DIR=@SA_DIR@
SYSCONFIG_DIR=@SYSCONFIG_DIR@
SYSCONFIG_FILE=@SYSCONFIG_FILE@
HISTORY=@HISTORY@
COMPRESSAFTER=@COMPRESSAFTER@
ZIP="@ZIP@"
PCP_HISTORY=${HISTORY}
PCP_COMPRESSAFTER=1
UMASK=0022
ENDIR=@SAR_DIR@
DELAY_RANGE=@DELAY_RANGE@

# Read configuration file, overriding variables set above
[ -r ${SYSCONFIG_DIR}/${SYSCONFIG_FILE} ] && . ${SYSCONFIG_DIR}/${SYSCONFIG_FILE}

umask ${UMASK}

# Wait for a random delay if requested
if [ ${DELAY_RANGE} -gt 0 ]
then
	RANDOM=$$
	DELAY=$((${RANDOM}%${DELAY_RANGE}))
	sleep ${DELAY}
fi

[ -d ${SA_DIR} ] || SA_DIR=@SA_DIR@

# if YESTERDAY=no then today's summary is generated
if [ x$YESTERDAY = xno ]
then
	DATE_OPTS=
else
	DATE_OPTS="--date=yesterday"
fi

case "${SADC_OPTIONS}" in *-D*) LONG_NAME=y ;; esac
if [ ${HISTORY} -gt 28 ] || [ "${LONG_NAME}" = "y" ]
then
	DATE=`date ${DATE_OPTS} +%Y%m%d`
else
	DATE=`date ${DATE_OPTS} +%d`
fi
CURRENTFILE=sa${DATE}
CURRENTRPT=sar${DATE}

RPT=${SA_DIR}/${CURRENTRPT}
DFILE=${SA_DIR}/${CURRENTFILE}
if [ -z "${ENDIR}" ];
then
       ENDIR=@bindir@
fi

[ -f "${DFILE}" ] || exit 0
cd ${ENDIR}
if [ x${REPORTS} != xfalse ]
then
	S_REPEAT_HEADER=${REPEAT_HEADER} ${ENDIR}/sar $* -f ${DFILE} > ${RPT}
fi

SAFILES_REGEX='/sar?[0-9]{2,8}(\.(Z|gz|bz2|xz|lz|lzo))?$'

find "${SA_DIR}" -type f -mtime +${HISTORY} \
	| grep -E "${SAFILES_REGEX}" \
	| xargs   rm -f

UNCOMPRESSED_SAFILES_REGEX='/sar?[0-9]{2,8}$'

find "${SA_DIR}" -type f -mtime +${COMPRESSAFTER} \
	| grep -E "${UNCOMPRESSED_SAFILES_REGEX}" \
	| xargs -r "${ZIP}" > /dev/null

# PCP archive management (only when PCP directories are present)
# PCP_HISTORY and PCP_COMPRESSAFTER can be overridden in the sysconfig file.
[ -r ${SYSCONFIG_DIR}/${SYSCONFIG_FILE} ] && . ${SYSCONFIG_DIR}/${SYSCONFIG_FILE}

PCP_DIR_REGEX='/pcp[0-9]{2,8}$'

# Remove PCP archive directories older than PCP_HISTORY days
find "${SA_DIR}" -type d -mtime +${PCP_HISTORY} \
	| grep -E "${PCP_DIR_REGEX}" \
	| xargs -r rm -rf

# Compress completed PCP data volumes older than PCP_COMPRESSAFTER days.
# pmlogcompress is preferred (part of pcp package) but may not be installed
# when only pcp-libs is present; fall back to compressing volumes with ZIP.
find "${SA_DIR}" -type d -mtime +${PCP_COMPRESSAFTER} \
	| grep -E "${PCP_DIR_REGEX}" \
	| while read pcp_dir; do
		base=$(basename "${pcp_dir}")
		if command -v pmlogcompress >/dev/null 2>&1; then
			pmlogcompress "${pcp_dir}/${base}" > /dev/null 2>&1
		else
			# Compress data volumes individually; PCP reads .N.xz transparently
			find "${pcp_dir}" -name "${base}.[0-9]*" \
				! -name "*.gz" ! -name "*.xz" ! -name "*.zst" \
				! -name "*.bz2" | xargs -r "${ZIP}" > /dev/null
		fi
	done

exit 0
